# Template for apps/web/.env, written by `pnpm run env:pull`. Plain values are
# copied as they are; 1Password secret references are resolved. Never put a
# secret here, and never edit the generated .env by hand.

# The same local Postgres as the API; Payload keeps to the `payload` schema.
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/peta
PAYLOAD_SECRET=op://PETA/Payload/payload_secret_local
REVALIDATE_SECRET=op://PETA/Payload/revalidate_secret_local
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
# The first CMS admin, created by the seed (it refuses to run without one).
PAYLOAD_ADMIN_EMAIL=admin@localhost.test
PAYLOAD_ADMIN_PASSWORD=op://PETA/Payload/admin_password_local
# Optional: media goes to local disk unless all of these are set.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
