# Template for apps/api/.env, written by `pnpm run env:pull`. Plain values are
# copied as they are; 1Password secret references are resolved. Never
# put a secret here, and never edit the generated .env by hand.

PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/peta
CLERK_SECRET_KEY=op://PETA/Clerk/CLERK_SECRET_KEY
# Optional. Errors are only reported to Better Stack when set; local dev
# leaves it empty.
BETTERSTACK_DSN=
